[Unit]
Description=TiDB Java Demo App (127.0.0.1:18080)
After=network.target

[Service]
Type=simple
User=tidbdemo
Group=tidbdemo
EnvironmentFile=/opt/tidb-demo/app.env
Environment=JAVA_HOME=/opt/jdk-17
WorkingDirectory=/opt/tidb-demo
ExecStart=/opt/jdk-17/bin/java -Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError -Dconfig=/opt/tidb-demo/app.properties -jar /opt/tidb-demo/tidb-demo.jar serve
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/tidb-demo/logs/app.log
StandardError=append:/opt/tidb-demo/logs/app.log

[Install]
WantedBy=multi-user.target
